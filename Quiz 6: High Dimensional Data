      "source": [
        "import pandas as pa\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "df = pa.read_csv('https://raw.githubusercontent.com/nurfnick/Data_Viz/refs/heads/main/Data_Sets/Activity_Dataset_V1.csv')"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 648
        },
        "id": "2cbdda1a",
        "outputId": "1f6dee9b-4359-4033-a2a4-381a1e14abb9"
      },
      "source": [
        "fig, ax = plt.subplots(figsize=(12, 6))\n",
        "sns.scatterplot(x='workout_type', y='calories', hue='time', size='avg_heart_rate', color='distance', data=df, alpha=0.7, ax=ax)\n",
        "\n",
        "ax.set_title('Calories Burned by Type of Workout (Colored by Time, Sized by Average Heart Rate)')\n",
        "ax.set_xlabel('Type of Workout')\n",
        "ax.set_ylabel('Calories Burned')\n",
        "ax.set_xticklabels(ax.get_xticklabels(), rotation=45, ha='right')\n",
        "ax.grid(True, linestyle='--', alpha=0.6)\n",
        "\n",
        "ax.legend(title='Time (minutes)', bbox_to_anchor=(1.05, 1.0), loc='upper left', borderaxespad=0.)\n",
        "\n",
        "fig.subplots_adjust(right=0.75)\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()"
      ],
